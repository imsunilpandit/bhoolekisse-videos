<!DOCTYPE html><html><head><meta charset="utf-8"><style>
html,body{margin:0;background:#000}
@font-face{font-family:Rozha;src:url(fonts/fontsource-rozha-one-5.3.0/package/files/rozha-one-devanagari-400-normal.woff2)}
@font-face{font-family:Rozha;src:url(fonts/fontsource-rozha-one-5.3.0/package/files/rozha-one-latin-400-normal.woff2)}
@font-face{font-family:Tiro;src:url(fonts/fontsource-tiro-devanagari-hindi-5.3.0/package/files/tiro-devanagari-hindi-devanagari-400-normal.woff2)}
@font-face{font-family:Tiro;src:url(fonts/fontsource-tiro-devanagari-hindi-5.3.0/package/files/tiro-devanagari-hindi-latin-400-normal.woff2)}
@font-face{font-family:TiroI;src:url(fonts/fontsource-tiro-devanagari-hindi-5.3.0/package/files/tiro-devanagari-hindi-devanagari-400-italic.woff2)}
@font-face{font-family:TiroI;src:url(fonts/fontsource-tiro-devanagari-hindi-5.3.0/package/files/tiro-devanagari-hindi-latin-400-italic.woff2)}
@font-face{font-family:Inter;font-weight:700;src:url(fonts/fontsource-inter-5.3.0/package/files/inter-latin-700-normal.woff2)}
</style></head><body><canvas id="c" width="1080" height="1920"></canvas><script>
const c=document.getElementById('c'),x=c.getContext('2d'),W=1080,H=1920;
const cl=v=>Math.max(0,Math.min(1,v)),eo=v=>1-Math.pow(1-cl(v),3),eio=v=>{v=cl(v);return v<.5?4*v*v*v:1-Math.pow(-2*v+2,3)/2};
const back=v=>{v=cl(v);const s=1.7;return 1+(s+1)*Math.pow(v-1,3)+s*Math.pow(v-1,2)};const lerp=(a,b,t)=>a+(b-a)*t;
let sd=11;const rnd=()=>{sd=(sd*16807)%2147483647;return sd/2147483647};
const BLUE='#1F3A85',RED='#C8372D',INK='#2a2420';
// ---------- paper ----------
const paper=document.createElement('canvas');paper.width=W;paper.height=H;{const g=paper.getContext('2d');g.fillStyle='#EFE8DA';g.fillRect(0,0,W,H);
 for(let i=0;i<1600;i++){const r=20+rnd()*120,X=rnd()*W,Y=rnd()*H,gr=g.createRadialGradient(X,Y,0,X,Y,r);gr.addColorStop(0,rnd()>.5?'rgba(255,252,240,0.035)':'rgba(150,120,80,0.025)');gr.addColorStop(1,'rgba(0,0,0,0)');g.fillStyle=gr;g.fillRect(X-r,Y-r,2*r,2*r)}
 for(let i=0;i<60000;i++){g.fillStyle=`rgba(60,45,30,${rnd()*0.07})`;g.fillRect(rnd()*W,rnd()*H,1.4,1.4)}
 g.strokeStyle='rgba(120,110,95,0.07)';g.lineWidth=1;for(let i=0;i<W;i+=36){g.beginPath();g.moveTo(i,0);g.lineTo(i,H);g.stroke()}for(let i=0;i<H;i+=36){g.beginPath();g.moveTo(0,i);g.lineTo(W,i);g.stroke()}}
// ---------- assets ----------
const IM={};const names=['bg','pillar','chariot','temple','cutpillar','hammer','veena','bg_papercut','pillar_stained','pillar_anime','temple_miniature','chariot_miniature','pillar_ukiyo','pillar_puppet','hammer_puppet','cutpillar_ink','pillar_warli','veena_warli'];
function load(n,src){return new Promise(r=>{const i=new Image();i.onload=()=>{IM[n]=i;r()};i.onerror=()=>r();i.src=src})}
const loads=[load('logo','logo.png')];names.forEach(n=>{loads.push(load(n,`assets/${n}.png`));loads.push(load(n+'_sk',`assets/${n}_sketch.png`))});
// ---------- helpers ----------
function label(s,X,Y,rot,p,fs=46,font='TiroI'){if(p<=0)return;const sc=back(p);x.save();x.translate(X,Y);x.rotate(rot);x.scale(sc,sc);x.font=`${fs}px ${font}`;const w=x.measureText(s).width+44,h=fs*1.55;
 x.shadowColor='rgba(40,25,10,0.28)';x.shadowBlur=14;x.shadowOffsetY=6;x.fillStyle='#F8F4EA';x.fillRect(-w/2,-h/2,w,h);x.shadowColor='transparent';x.fillStyle='rgba(120,100,70,0.08)';x.fillRect(-w/2,h/2-6,w,6);
 x.fillStyle=INK;x.textAlign='center';x.textBaseline='middle';x.fillText(s,0,4);x.restore()}
function pill(s,X,Y,p,col=INK,bg='rgba(250,246,238,0.96)',fs=38){if(p<=0)return;const sc=back(p);x.save();x.translate(X,Y);x.scale(sc,sc);x.font=`${fs}px Tiro`;const w=x.measureText(s).width+44,h=fs*1.5;
 x.shadowColor='rgba(40,25,10,0.22)';x.shadowBlur=10;x.shadowOffsetY=4;x.fillStyle=bg;x.beginPath();x.roundRect(-w/2,-h/2,w,h,h/2);x.fill();x.shadowColor='transparent';x.fillStyle=col;x.textAlign='center';x.textBaseline='middle';x.fillText(s,0,4);x.restore()}
function headline(s,X,Y,p,fs=118,col=BLUE,align='center'){if(p<=0)return;x.save();x.font=`${fs}px Rozha`;x.textAlign=align;const w=x.measureText(s).width;const L=align==='center'?X-w/2:X;
 x.beginPath();x.rect(L-20,Y-fs*1.1,(w+40)*eo(p),fs*1.5);x.clip();x.fillStyle=col;x.shadowColor='rgba(20,30,60,0.18)';x.shadowBlur=6;x.shadowOffsetY=4;x.fillText(s,X,Y);x.restore()}
// image placed by centre+height; sketch draws in (top->bottom pencil reveal), then glowing line wipes upward to the real cut-out
function img(n,cx,cy,h,sp,rp,a=1){const I=IM[n],S=IM[n+'_sk'];if(!I)return null;const w=I.width*h/I.height,X=cx-w/2,Y=cy-h/2;x.save();x.globalAlpha=a;
 if(rp<1&&S&&sp>0){x.save();x.beginPath();x.rect(X-10,Y-10,w+20,(h+20)*eo(sp));x.clip();x.globalAlpha=a*0.9;x.drawImage(S,X,Y,w,h);x.restore()}
 if(rp>0){const yy=lerp(Y+h+10,Y-10,eio(rp));x.save();x.beginPath();x.rect(X-40,yy,w+80,Y+h+60-yy);x.clip();x.shadowColor='rgba(40,25,10,0.35)';x.shadowBlur=26;x.shadowOffsetY=14;x.drawImage(I,X,Y,w,h);x.restore();
  if(rp<1){x.save();x.strokeStyle='rgba(255,250,235,0.95)';x.lineWidth=4;x.shadowColor='rgba(255,210,120,1)';x.shadowBlur=24;x.beginPath();x.moveTo(X-30,yy);x.lineTo(X+w+30,yy);x.stroke();x.restore()}}
 x.restore();return {X,Y,w,h}}
function circ(cx,cy,rx,ry,p,col=RED){if(p<=0)return;x.save();x.strokeStyle=col;x.lineWidth=7;x.lineCap='round';x.beginPath();const N=70;for(let i=0;i<=N*cl(p);i++){const a=-1.3+i/N*6.7,r=1+Math.sin(i*0.45)*0.025+i*0.0012;const X=cx+Math.cos(a)*rx*r,Y=cy+Math.sin(a)*ry*r;i?x.lineTo(X,Y):x.moveTo(X,Y)}x.stroke();x.restore()}
function arrow(x0,y0,x1,y1,p,col=RED){if(p<=0)return;const q=eo(p),X=lerp(x0,x1,q),Y=lerp(y0,y1,q);x.save();x.strokeStyle=col;x.fillStyle=col;x.lineWidth=7;x.lineCap='round';x.beginPath();x.moveTo(x0,y0);x.quadraticCurveTo((x0+X)/2+30,(y0+Y)/2-30,X,Y);x.stroke();
 if(q>0.9){const a=Math.atan2(y1-y0,x1-x0);x.beginPath();x.moveTo(X,Y);x.lineTo(X-30*Math.cos(a-0.45),Y-30*Math.sin(a-0.45));x.lineTo(X-30*Math.cos(a+0.45),Y-30*Math.sin(a+0.45));x.closePath();x.fill()}x.restore()}
function dashed(x0,y0,x1,y1,p){if(p<=0)return;x.save();x.strokeStyle='rgba(42,36,32,0.75)';x.lineWidth=3;x.setLineDash([14,10]);x.beginPath();x.moveTo(x0,y0);x.lineTo(lerp(x0,x1,eo(p)),lerp(y0,y1,eo(p)));x.stroke();x.restore()}
function count(a,b,p){return Math.round(lerp(a,b,eo(p)))}
const hi=n=>n.toLocaleString('en-IN');
