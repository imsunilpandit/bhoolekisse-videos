[{"s": 0, "e": 0.948073, "text": "एक मंदिर...", "lines": [0]}, {"s": 1.6039, "e": 3.63948, "text": "जिसके पत्थर के खंभों को थपथपाओ,", "lines": [0]}, {"s": 4.06102, "e": 5.28195, "text": "तो संगीत निकलता है!", "lines": [0]}, {"s": 5.73871, "e": 8.4556, "text": "सा... रे... गा... मा...", "lines": [1]}, {"s": 9.07776, "e": 10.4791, "text": "क्या आपको पता है ये कहाँ है?", "lines": [2]}, {"s": 10.8994, "e": 11.6098, "text": "कमेंट में लिखिए...", "lines": [2]}, {"s": 11.9759, "e": 13.4163, "text": "और अब सुनिए राज़।", "lines": [2]}, {"s": 13.8373, "e": 15.9223, "text": "ये है कर्नाटक के हम्पी का,", "lines": [3]}, {"s": 16.3109, "e": 17.4988, "text": "विजय विट्ठल मंदिर...", "lines": [3]}, {"s": 17.9611, "e": 19.8, "text": "विजयनगर साम्राज्य की शान।", "lines": [3]}, {"s": 20.2758, "e": 23.3457, "text": "इसके रंग मंडप में हैं, छप्पन संगीत खंभे...", "lines": [4]}, {"s": 23.7508, "e": 25.7975, "text": "हर खंभा करीब बारह फ़ुट ऊँचा।", "lines": [4]}, {"s": 26.1925, "e": 27.9868, "text": "एक मोटे खंभे के चारों ओर,", "lines": [5]}, {"s": 28.4283, "e": 29.8313, "text": "पतले खंभों का गुच्छा...", "lines": [5]}, {"s": 30.2842, "e": 31.5535, "text": "और हर पतला खंभा,", "lines": [5]}, {"s": 31.9451, "e": 32.8651, "text": "अलग सुर देता है।", "lines": [5]}, {"s": 33.312, "e": 33.9435, "text": "और ये सब...", "lines": [6]}, {"s": 34.3141, "e": 35.9236, "text": "ठोस पत्थर से तराशा गया।", "lines": [6]}, {"s": 36.3307, "e": 40.4219, "text": "कहते हैं, अंग्रेज़ों ने राज़ जानने के लिए, दो खंभे काट डाले...", "lines": [7]}, {"s": 40.8188, "e": 42.1106, "text": "पर अंदर कुछ नहीं मिला...", "lines": [8]}, {"s": 42.5727, "e": 43.698, "text": "बस ठोस पत्थर।", "lines": [8]}, {"s": 44.1567, "e": 47.3228, "text": "आज लगातार थपथपाने से ये खंभे घिस रहे हैं...", "lines": [9]}, {"s": 47.7528, "e": 49.1647, "text": "इसलिए इन्हें छूना नहीं,", "lines": [9]}, {"s": 49.6011, "e": 50.8978, "text": "बस महसूस करना।", "lines": [9]}, {"s": 51.2107, "e": 58.279184, "text": "क्या आपको पता था, पत्थर भी गा सकते हैं? कमेंट में बताइए... और ऐसे ही भूले किस्सों के लिए, अभी सब्सक्राइब करें!", "lines": [10]}]